#!/bin/bash

# Claude Code Docker Wrapper Script
# This script makes it easy to run Claude Code in a secure Docker container

set -e

# Binary lives in bin/ of the self-contained checkout (Doom-style).
# It is reached via PATH, never via a symlink in ~/.local/bin.
BIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_ROOT="$(cd "$BIN_DIR/.." && pwd)"
IMAGE_NAME="claude-dockerized:latest"

# Wrapper release line, shown by the version command next to the Claude Code
# version and the bundled guard version.
WRAPPER_VERSION="0.1.0"


# In-container diagnostics for the wrapper security layer, SSH and GnuPG
# forwarding, managed settings and LSP/formatters.
# Read-only: it only reports what is actually usable and exits non-zero on a
# real failure (e.g. GPG enabled but the agent socket or public keyring is
# missing, so signed commits would fail).
# shellcheck disable=SC2016 # expanded inside the container, not here
DOCTOR_SCRIPT='
status=0
note() { printf "%s\n" "$1"; }
echo "== guard hooks =="
if [ -x /home/coder/.claude/hooks-guard/claude-guard-bash.sh ] && [ -x /home/coder/.claude/hooks-guard/claude-guard-file.sh ]; then
    grep -m1 CLAUDE_DOCKERIZED_GUARD_VERSION /home/coder/.claude/hooks-guard/claude-guard-bash.sh || true
    if [ -f /home/coder/.claude/hooks-guard/policies/VERSION ]; then
        note "policies: v$(cat /home/coder/.claude/hooks-guard/policies/VERSION 2>/dev/null)"
    else
        note "policies: MISSING"; status=1
    fi
else
    note "MISSING guard hooks"; status=1
fi
echo "== managed settings =="
managed=/etc/claude-code/managed-settings.json
if [ -f "$managed" ]; then
    if grep -q DISABLE_AUTOUPDATER "$managed" 2>/dev/null; then
        note "auto-updates: disabled (managed policy)"
    else
        note "auto-updates: NOT disabled in $managed"; status=1
    fi
    if grep -q claude-guard-bash.sh "$managed" 2>/dev/null; then
        note "guard hooks: wired in the managed policy"
    else
        note "guard hooks: NOT wired in $managed"; status=1
    fi
    if touch "$managed" 2>/dev/null; then
        note "managed policy: WRITABLE (must be a read-only mount)"; status=1
    fi
    if [ -w "$us" ]; then
        note "user settings: writable (/model and /config persist)"
    else
        note "user settings: NOT writable (/model cannot save)"; status=1
    fi
else
    note "MISSING $managed"; status=1
fi
for f in "$managed" /home/coder/.claude/settings.json "${CLAUDE_DOCKERIZED_WORKDIR:-.}/.claude/settings.json" "${CLAUDE_DOCKERIZED_WORKDIR:-.}/.claude/settings.local.json"; do
    if [ -f "$f" ] && grep -q disableAllHooks "$f" 2>/dev/null; then
        note "disableAllHooks: PRESENT in $f"; status=1
    fi
done
note "policy mode: $(cat /home/coder/.claude/hooks-guard/policy-mode 2>/dev/null || echo "MISSING")"
echo "== claude =="
claude --version 2>&1 || { note "claude binary: FAILED"; status=1; }
if command -v claude >/dev/null 2>&1; then
    claude doctor 2>&1 || note "(native claude doctor reported issues above)"
fi
echo "== ssh agent =="
if [ "${CLAUDE_DOCKERIZED_SSH_AGENT:-false}" != true ]; then
    note "ssh agent forwarding: disabled in wrapper config (skipped)"
elif [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ]; then
    ssh-add -l 2>&1 || true
else
    note "SSH_AUTH_SOCK is unset or not a socket"; status=1
fi
echo "== gnupg =="
if [ "${CLAUDE_DOCKERIZED_GPG_AGENT:-false}" != true ]; then
    note "gnupg forwarding: disabled in wrapper config (skipped)"
else
gpg_home="${GNUPGHOME:-$HOME/.gnupg}"
if [ -S "$gpg_home/S.gpg-agent" ]; then
    note "agent socket: ok"
else
    note "agent socket: MISSING ($gpg_home/S.gpg-agent)"; status=1
fi
if [ -f "$gpg_home/pubring.kbx" ] || [ -f "$gpg_home/public-keys.d/pubring.db" ]; then
    note "public keyring: ok"
else
    note "public keyring: MISSING (signed commits will fail)"; status=1
fi
if gpg --list-keys >/dev/null 2>&1; then
    note "list-keys: ok"
else
    note "list-keys: FAILED"; gpg --list-keys 2>&1 | head -3; status=1
fi
if ! gpg --list-secret-keys >/dev/null 2>&1; then
    note "list-secret-keys: none visible (the forwarded agent can still sign by key id)"
fi
signingkey=$(gpg --list-keys --with-colons 2>/dev/null | grep "^pub:" | head -n1 | cut -d: -f5)
if [ -n "$signingkey" ]; then
    if printf test | timeout 5 gpg --batch --local-user "$signingkey" --sign >/dev/null 2>&1; then
        note "sign probe: ok ($signingkey)"
    else
        note "sign probe: could not sign non-interactively ($signingkey); confirm with a real signed commit (pinentry runs on the host)"
    fi
else
    note "sign probe: skipped (no public key)"
fi
fi
echo "== config secrets =="
sc=/home/coder/.claude/settings.json
if [ -f "$sc" ] && grep -oE "\"(apiKey|api_key|token|secret|password|authorization)\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$sc" 2>/dev/null | grep -qvE "\\$|apiKeyHelper"; then
    note "inline secrets: FOUND in settings.json (move them to the env file or apiKeyHelper)"; status=1
else
    note "inline secrets: none"
fi
echo "== runtime hardening =="
note "profile: ${CLAUDE_DOCKERIZED_HARDENING:-off} (setting.hardening: off|standard|strict)"
if probe=$(mktemp -p /usr 2>/dev/null); then unlink "$probe"; note "root filesystem: writable"; else note "root filesystem: read-only"; fi
echo "== model =="
if [ -n "${CLAUDE_DOCKERIZED_MODEL:-}" ]; then
    note "model: ${CLAUDE_DOCKERIZED_MODEL} (wrapper default; /model still works)"
else
    note "model: default (not preset)"
fi
echo "== lsp / formatters =="
if [ "${CLAUDE_DOCKERIZED_LSP:-false}" = true ]; then
    for bin in gopls typescript-language-server pyright-langserver rust-analyzer; do
        if command -v "$bin" >/dev/null 2>&1; then note "lsp: $bin ok"; else note "lsp: $bin MISSING"; fi
    done
else
    note "lsp: disabled in wrapper config (skipped)"
fi
if [ "${CLAUDE_DOCKERIZED_FORMATTERS:-false}" = true ]; then
    for bin in ruff prettier; do
        if command -v "$bin" >/dev/null 2>&1; then note "formatter: $bin ok"; else note "formatter: $bin MISSING"; fi
    done
else
    note "formatters: disabled in wrapper config (skipped)"
fi
echo "== env file =="
if [ "${CLAUDE_DOCKERIZED_ENV_FILE:-no}" = yes ]; then
    note "env file: loaded (--env-file)"
else
    note "env file: not configured"
fi
echo "== result =="
if [ "$status" -eq 0 ]; then note "all good"; else note "problems detected"; fi
exit "$status"
'

# Colors for output (defined before sourcing config-lib so it picks them up)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Source the shared config module
source "$REPO_ROOT/lib/config-lib.sh"

# Bare `mktemp` honors TMPDIR, so merge temps land in a private dir without
# touching every call site (see ensure_private_tmpdir).
ensure_private_tmpdir

# Function to print colored output
print_info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

# Function to check if Docker is running
check_docker() {
    if ! docker info >/dev/null 2>&1; then
        print_error "Docker is not running. Please start Docker and try again."
        exit 1
    fi
}

# Refuse to run as root. The container is launched with the host UID/GID, so a
# root invocation would start the sandbox as root and defeat the whole setup.
check_not_root() {
    if [ "$(id -u)" -eq 0 ]; then
        print_error "Do not run this wrapper as root."
        print_info "Run it as your normal user so the container starts as your host UID/GID."
        exit 1
    fi
}

# Image build options from the wrapper config (opt-in; defaults build the
# historic image). Sets IMAGE_BUILD_ARGS. Usage: image_build_args
image_build_args() {
    parse_config || true
    IMAGE_BUILD_ARGS=()
    [ "$IMAGE_STRIP_SETUID" = true ] && IMAGE_BUILD_ARGS+=(--build-arg STRIP_SETUID=1)
    [ "$IMAGE_DOCKER_CLI" = false ] && IMAGE_BUILD_ARGS+=(--build-arg DOCKER_CLI=0)
    return 0
}

# Function to build the Docker image
build_image() {
    print_info "Building Claude Code Docker image..."
    image_build_args
    # Regular build uses Docker layer cache normally.
    # Only the 'update' command passes CLAUDE_BUILD_TIME to bust the cache.
    docker build "${IMAGE_BUILD_ARGS[@]}" -t "$IMAGE_NAME" "$REPO_ROOT"
    print_success "Docker image built successfully"
}

# Function to check required configuration files (self-contained CCODE_HOME tree)
check_config() {
    local missing_files=()

    if [ ! -f "$CCODE_HOME/etc/claude-code/managed-settings.json" ]; then
        missing_files+=("$CCODE_HOME/etc/claude-code/managed-settings.json")
    fi

    if [ ! -d "$CCODE_HOME/.local/share/claude" ]; then
        missing_files+=("$CCODE_HOME/.local/share/claude/")
    fi

    if [ ! -d "$CCODE_HOME/.local/state/claude" ]; then
        missing_files+=("$CCODE_HOME/.local/state/claude/")
    fi

    if [ ${#missing_files[@]} -gt 0 ]; then
        print_warning "Some Claude Code configuration files are missing:"
        for file in "${missing_files[@]}"; do
            echo "  - $file"
        done
        print_info "Claude Code will run but may need configuration. Run 'claude auth login' inside the container."
    fi

    # Ensure storage directories exist and the security layer is present.
    # The config is parsed first so the managed layer is generated once with
    # the configured policy/model, never with defaults (then rewritten).
    parse_config
    ensure_claude_dirs
}

# Run a one-off Claude Code CLI command inside the container.
# The project directory is mounted so project-level configuration applies.
# Usage: run_cli_command <name_suffix> <project_dir> <docker_socket> <claude_args...>
run_cli_command() {
    local name_suffix="$1"
    local project_dir="$2"
    local docker_socket="$3"
    shift 3

    if [ -n "$project_dir" ]; then
        if [ ! -d "$project_dir" ]; then
            print_error "Project directory does not exist: $project_dir"
            exit 1
        fi
        project_dir="$(cd "$project_dir" && pwd -P)"
        validate_project_dir "$project_dir" || exit 1
    fi

    check_image "$IMAGE_NAME" || exit 1
    parse_config
    ensure_claude_dirs

    build_mount_args
    build_env_args
    build_env_file_args
    build_common_docker_args
    build_standard_volume_args "$project_dir" "$docker_socket"

    # Allocate a TTY only when attached to one, so the command stays pipeable
    local -a tty_args=(-i)
    [ -t 0 ] && [ -t 1 ] && tty_args=(-it)

    local -a workdir_args=()
    [ -n "$CONTAINER_WORKDIR" ] && workdir_args=(--workdir "$CONTAINER_WORKDIR")

    local -a docker_cmd=(
        docker run "${tty_args[@]}"
        --name "claude-${name_suffix}-$$"
        "${workdir_args[@]}"
        "${DOCKER_COMMON_ARGS[@]}"
        "${VOLUME_ARGS[@]}"
        "${GIT_WORKTREE_ARGS[@]}"
        "${DOCKER_MOUNT_ARGS[@]}"
        "${DOCKER_ENV_ARGS[@]}"
        "${DOCKER_ENV_FILE_ARGS[@]}"
        "$IMAGE_NAME"
        "$@"
    )

    if [ "${DRY_RUN:-false}" = true ]; then
        print_info "Dry run — would execute:"
        dry_run_print "${docker_cmd[@]}"
        stop_gpg_relay "$GPG_RELAY_SOCKET"
        GPG_RELAY_SOCKET=""
        return 0
    fi

    # Stop the per-session GnuPG relay when the container exits (also on error
    # or Ctrl-C via the EXIT/INT/TERM trap).
    trap 'stop_gpg_relay "$GPG_RELAY_SOCKET"' EXIT INT TERM
    "${docker_cmd[@]}"
    stop_gpg_relay "$GPG_RELAY_SOCKET"
    GPG_RELAY_SOCKET=""
    trap - EXIT INT TERM
}

# Function to run Claude Code authentication
run_auth() {
    print_info "Running Claude Code authentication..."
    print_info "Complete the login in the container (browser or pasted OAuth code)."

    if ! run_cli_command auth "" false claude auth login; then
        print_error "Authentication failed"
        exit 1
    fi

    print_success "Authentication complete! Your credentials are saved in $CCODE_HOME/.claude/.credentials.json"
}

# Function to run Claude Code
run_claude() {
    local project_dir="${1:-$(pwd)}"
    local dry_run="${DRY_RUN:-false}"

    # Validate project directory exists
    if [ ! -d "$project_dir" ]; then
        print_error "Project directory does not exist: $project_dir"
        exit 1
    fi

    # Convert to absolute, symlink-resolved path (a symlink to $HOME or / must
    # not slip past validate_project_dir).
    project_dir="$(cd "$project_dir" && pwd -P)"

    # Never mount "/", $HOME or an ancestor of $HOME: it would expose the host
    # home (or the whole filesystem) read-write to the agent.
    validate_project_dir "$project_dir" || exit 1

    check_image "$IMAGE_NAME" || exit 1

    # Generate unique container name based on project directory and random suffix
    local dir_name
    dir_name=$(sanitize_container_name "$(basename "$project_dir")")
    local random_suffix
    random_suffix=$(generate_random_suffix)
    local container_name="claude-${dir_name}-${random_suffix}"

    print_info "Starting Claude Code in Docker..."
    print_info "Project directory: $project_dir"
    print_info "Container name: $container_name"

    # Parse custom config and build docker arguments
    parse_config
    build_mount_args
    build_env_args
    build_env_file_args
    build_common_docker_args
    # Docker socket is opt-in: mounting it is root-equivalent on the host.
    build_standard_volume_args "$project_dir" "$DOCKER_SOCKET"

    # CONTAINER_WORKDIR is set by build_standard_volume_args (host path with $HOME stripped)
    local -a model_args=()
    [ -n "$CLAUDE_MODEL" ] && model_args=(--model "$CLAUDE_MODEL")

    local -a docker_cmd=(
        docker run -it
        --name "$container_name"
        --workdir "$CONTAINER_WORKDIR"
        -e "CLAUDE_DOCKERIZED_WORKDIR=$CONTAINER_WORKDIR"
        "${DOCKER_COMMON_ARGS[@]}"
        "${VOLUME_ARGS[@]}"
        "${GIT_WORKTREE_ARGS[@]}"
        "${DOCKER_MOUNT_ARGS[@]}"
        "${DOCKER_ENV_ARGS[@]}"
        "${DOCKER_ENV_FILE_ARGS[@]}"
        "$IMAGE_NAME"
        claude "${model_args[@]}"
    )

    if [ "$dry_run" = true ]; then
        print_info "Dry run — would execute:"
        dry_run_print "${docker_cmd[@]}"
        stop_gpg_relay "$GPG_RELAY_SOCKET"
        GPG_RELAY_SOCKET=""
        return 0
    fi

    # Fingerprint the persistent paths the session could plant code in
    # (setting.integrity_check, default on); compared after the session.
    local snap_before="" snap_after=""
    if [ "$INTEGRITY_CHECK" = true ]; then
        if snap_before=$(mktemp 2>/dev/null); then
            integrity_snapshot "$project_dir" "$snap_before"
        else
            snap_before=""
        fi
    fi

    # Stop the per-session GnuPG relay when the container exits.
    trap 'stop_gpg_relay "$GPG_RELAY_SOCKET"' EXIT INT TERM
    local rc=0
    "${docker_cmd[@]}" || rc=$?
    stop_gpg_relay "$GPG_RELAY_SOCKET"
    GPG_RELAY_SOCKET=""
    trap - EXIT INT TERM

    if [ -n "$snap_before" ]; then
        if snap_after=$(mktemp 2>/dev/null); then
            integrity_snapshot "$project_dir" "$snap_after"
            integrity_report "$project_dir" "$snap_before" "$snap_after" || true
        fi
        rm -f "$snap_before" "$snap_after"
    fi

    # Propagate Claude Code's own exit status (130 on Ctrl-C, etc.).
    if [ "$rc" -ne 0 ]; then
        print_error "Claude Code exited with status $rc"
        exit "$rc"
    fi
}

# Self-update helpers: `update` and `upgrade` both perform the full upgrade
# (git pull from GitHub + security-layer sync + image rebuild). They differ
# only in prompting defaults: `upgrade` asks before pulling when interactive,
# `update` pulls without asking (preserves its historic one-shot behavior).
# Both accept [--check] [--yes] [--no-build] [--claude-version X].
# Usage: _git_pull_wrapper <yes:true|false> <check_only:true|false>
_git_pull_wrapper() {
    local yes="$1" check_only="$2"
    if [ ! -d "$REPO_ROOT/.git" ]; then
        print_error "Not a git checkout ($REPO_ROOT); reinstall with install.sh to enable self-update."
        return 1
    fi
    if ! command -v git >/dev/null 2>&1; then
        print_error "git is required for self-update."
        return 1
    fi
    if ! git -C "$REPO_ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
        print_error "No upstream tracking branch; set one with 'git branch --set-upstream-to=origin/<branch>'."
        return 1
    fi
    git -C "$REPO_ROOT" fetch origin >/dev/null 2>&1 || {
        print_error "Could not fetch from origin."
        return 1
    }
    local local_rev remote_rev base
    local_rev=$(git -C "$REPO_ROOT" rev-parse HEAD)
    remote_rev=$(git -C "$REPO_ROOT" rev-parse '@{u}')
    base=$(git -C "$REPO_ROOT" merge-base HEAD '@{u}')
    if [ "$local_rev" = "$remote_rev" ]; then
        print_success "Already up to date."
        return 2
    fi
    if [ "$local_rev" != "$base" ]; then
        print_error "Local checkout diverged from upstream; resolve manually with git (no --force pull attempted)."
        git -C "$REPO_ROOT" status -sb | head -5
        return 1
    fi
    local n
    n=$(git -C "$REPO_ROOT" rev-list --count HEAD..'@{u}')
    print_info "Update available: $n commit(s) behind upstream."
    if [ "$check_only" = true ]; then
        return 1
    fi
    if [ "$yes" != true ] && [ -t 0 ]; then
        local ans
        read -r -p "Pull $n commit(s)? (Y/n): " ans || ans=""
        case "${ans:-y}" in
        [Yy] | "") ;;
        *)
            print_info "Aborted."
            return 1
            ;;
        esac
    fi
    git -C "$REPO_ROOT" pull --ff-only || {
        print_error "Pull failed."
        return 1
    }
    print_success "Code updated to latest version."
    return 0
}

# Rebuild the image with cache-busting so the pinned Claude Code is installed.
_rebuild_claude_image() {
    print_info "Rebuilding image with pinned Claude Code..."
    local version_args=()
    if [ -n "${_UP_CLAUDE_VERSION:-}" ]; then
        version_args+=(--build-arg "CLAUDE_CODE_VERSION=$_UP_CLAUDE_VERSION")
        print_info "Requested Claude Code version: $_UP_CLAUDE_VERSION"
    fi
    image_build_args
    docker build --build-arg "CLAUDE_BUILD_TIME=$(date +%s)" "${version_args[@]}" "${IMAGE_BUILD_ARGS[@]}" -t "$IMAGE_NAME" "$REPO_ROOT"
    print_info "Updated Claude Code version:"
    docker run --rm --entrypoint bash "$IMAGE_NAME" -c "claude --version" 2>/dev/null || true
}

# Parse self-update flags shared by `update` and `upgrade`.
# Sets: _UP_CHECK, _UP_YES, _UP_NO_BUILD, _UP_CLAUDE_VERSION. Returns 0 on success/--help, 1 on bad usage.
# Usage: _parse_self_update_flags <command-name> [flags...]
_parse_self_update_flags() {
    local cmd="$1"; shift
    _UP_CHECK=false; _UP_YES=false; _UP_NO_BUILD=false; _UP_CLAUDE_VERSION=""
    local arg
    while [ $# -gt 0 ]; do
        arg="$1"; shift
        case "$arg" in
        --check) _UP_CHECK=true ;;
        --yes) _UP_YES=true ;;
        --no-build) _UP_NO_BUILD=true ;;
        --claude-version)
            [ -n "${1:-}" ] || { print_error "Missing value for --claude-version"; return 1; }
            _UP_CLAUDE_VERSION="$1"; shift
            ;;
        --claude-version=*) _UP_CLAUDE_VERSION="${arg#--claude-version=}" ;;
        --help | -h)
            echo "Usage: $0 $cmd [--check] [--yes] [--no-build] [--claude-version X.Y.Z]"
            echo "  --check    only report whether an update is available"
            echo "  --yes      pull and rebuild without asking"
            echo "  --no-build pull + sync only, skip the image rebuild"
            echo "  --claude-version X.Y.Z  pin a different Claude Code version for the rebuild"
            return 0
            ;;
        *)
            print_error "Unknown $cmd option: $arg (use --check|--yes|--no-build|--claude-version)"
            return 1
            ;;
        esac
    done
    if [ -n "$_UP_CLAUDE_VERSION" ] && [[ ! "$_UP_CLAUDE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        print_error "Invalid --claude-version '$_UP_CLAUDE_VERSION' (use X.Y.Z)"
        return 1
    fi
    return 0
}

# Full upgrade: git pull + security-layer sync + image rebuild.
# Usage: full_upgrade <command-name> [--check] [--yes] [--no-build] [--claude-version X]
full_upgrade() {
    local cmd="$1"; shift
    _parse_self_update_flags "$cmd" "$@" || return $?
    if [ "$_UP_CHECK" = true ]; then
        _git_pull_wrapper true true
        local check_rc=$?
        if [ "$check_rc" -eq 2 ]; then
            return 0
        fi
        return 1
    fi
    local pull_rc=0
    # `update` never prompts (historic one-shot); `upgrade` prompts when tty.
    if [ "$cmd" = "update" ]; then
        _git_pull_wrapper true false; pull_rc=$?
    else
        _git_pull_wrapper "$_UP_YES" false; pull_rc=$?
    fi
    if [ "$pull_rc" -eq 1 ]; then
        return 1
    fi
    print_success "Refreshing security layer..."
    parse_config || true
    sync_security_layer || true
    if [ "$_UP_NO_BUILD" = true ]; then
        print_info "Skipping image rebuild (--no-build)."
        print_success "Upgrade complete (code + config synced, image untouched)."
        return 0
    fi
    check_docker || return 1
    if ! docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        print_info "Image not found, building fresh..."
    else
        print_info "Current Claude Code version:"
        docker run --rm --entrypoint bash "$IMAGE_NAME" -c "claude --version" 2>/dev/null || true
    fi
    _rebuild_claude_image
    print_success "Upgrade complete (code + config + image)."
}

# Self-update the wrapper checkout from GitHub (Doom-style `doom upgrade`).
# `update` and `upgrade` both run the full upgrade (git pull + sync + rebuild).
# Usage: upgrade_wrapper [--check] [--yes] [--no-build] [--claude-version X]
upgrade_wrapper() {
    full_upgrade upgrade "$@"
}

# Function to update Claude Code (full upgrade: git pull + sync + rebuild).
# Usage: update_claude [--check] [--yes] [--no-build] [--claude-version X]
update_claude() {
    full_upgrade update "$@"
}

# Function to report the effective model configuration (local-only).
# Claude Code has no `models` list endpoint; the default comes from
# setting.model and can be switched per session with /model or --model.
show_models() {
    parse_config || true
    if [ -n "$CLAUDE_MODEL" ]; then
        echo "Default model: $CLAUDE_MODEL (from wrapper config; switch per session with /model)"
    else
        echo "Default model: Claude default (not preset; switch per session with /model)"
    fi
    maybe_drift_hint
}

# Function to show local session storage statistics (local-only, no secrets).
# API usage lives in the provider console; this reports what persists in the
# generated home across up/down/upgrade cycles.
show_stats() {
    parse_config || true
    local share="$CCODE_HOME/.local/share/claude"
    local state="$CCODE_HOME/.local/state/claude"
    local cache="$CCODE_HOME/.cache/claude"
    echo "Session storage (generated home: $CCODE_HOME):"
    for d in "$share" "$state" "$cache"; do
        if [ -d "$d" ]; then
            echo "  $d: $(du -sh "$d" 2>/dev/null | cut -f1)"
        else
            echo "  $d: (missing)"
        fi
    done
    echo "  cleanupPeriodDays: ${CLEANUP_DAYS:-(Claude default)}"
    if [ -f "$CCODE_HOME/.claude/.credentials.json" ]; then
        echo "  login: present (.credentials.json)"
    else
        echo "  login: missing (run 'claude-dockerized auth')"
    fi
}

# Warn that managed config is read-only inside the container and point the
# user at the host-side file to edit. Usage: config_readonly_guard <what>
config_readonly_guard() {
    local what="${1:-changes}"
    print_error "Managed Claude config is read-only inside the container; '$what' is not available from here."
    print_info "Edit it on the host instead: $0 config claude edit"
    print_info "Generated home: $CCODE_HOME/.claude/"
}

# Function to manage MCP servers (list, get, login, logout pass through;
# add/remove are host-only because managed config is read-only).
manage_mcp() {
    local subcommand="${1:-list}"
    shift || true
    case "$subcommand" in
    add | remove | reset)
        config_readonly_guard "claude mcp $subcommand"
        exit 1
        ;;
    esac
    run_cli_command mcp "$(pwd)" false claude mcp "$subcommand" "$@"
}

# Function to manage plugins (read-only subcommands pass through;
# install/update/remove are host-only).
manage_plugins() {
    local subcommand="${1:-list}"
    shift || true
    case "$subcommand" in
    install | add | update | upgrade | remove | uninstall | enable | disable)
        config_readonly_guard "claude plugin $subcommand"
        exit 1
        ;;
    esac
    run_cli_command plugin "$(pwd)" false claude plugin "$subcommand" "$@"
}

# Function to run debugging helpers.
# `paths` is local-only (resolved wrapper paths); `doctor` runs the native
# `claude doctor` inside the container; anything else passes to `claude --debug`.
run_debug() {
    local subcommand="${1:-paths}"
    shift || true
    case "$subcommand" in
    paths)
        parse_config || true
        echo "Generated home: $CCODE_HOME"
        echo "Managed policy: $CCODE_HOME/.claude/managed-settings.json (-> /etc/claude-code/managed-settings.json, ro)"
        echo "User settings: $CCODE_HOME/.claude/settings.json (ro)"
        echo "Guard hooks: $CCODE_HOME/.claude/hooks-guard/"
        echo "Credentials: $CCODE_HOME/.claude/.credentials.json"
        echo "MCP state: $CCODE_HOME/.claude.json"
        echo "Sessions: $CCODE_HOME/.local/share/claude"
        maybe_drift_hint
        ;;
    doctor)
        check_docker
        run_cli_command debug "" false claude doctor "$@"
        ;;
    *)
        check_docker
        run_cli_command debug "$(pwd)" false claude --debug "$subcommand" "$@"
        ;;
    esac
}

# Diagnose the security layer, SSH and GnuPG forwarding inside the container.
# Project-independent: doctor needs no project mount (like auth).
run_doctor() {
    parse_config || true
    echo "== session integrity (host) =="
    if [ "$INTEGRITY_CHECK" != true ]; then
        echo "integrity check: disabled (setting.integrity_check=false)"
    else
        local last
        last=$(integrity_last_report)
        if [ -n "$last" ]; then
            echo "last reported change: $last"
            echo "full log: $CONFIG_DIR/audit/sessions.jsonl"
        else
            echo "no persistent-path changes recorded"
        fi
    fi
    run_cli_command doctor "" false bash -c "$DOCTOR_SCRIPT"
}

# Function to run a non-interactive prompt and print the result
exec_prompt() {
    if [ $# -eq 0 ]; then
        print_error "A message is required: $0 exec \"<message>\" [OPTIONS]"
        exit 1
    fi
    # Docker socket follows the opt-in config, as in 'run'. parse_config must run
    # first so DOCKER_SOCKET reflects setting.docker_socket before it is read.
    parse_config
    local -a model_args=()
    [ -n "$CLAUDE_MODEL" ] && model_args=(--model "$CLAUDE_MODEL")
    run_cli_command exec "$(pwd)" "$DOCKER_SOCKET" claude -p "${model_args[@]}" "$@"
}

# Function to clean up Docker image
clean_image() {
    # Drop any relay processes/dirs left by crashed sessions.
    cleanup_stale_relays
    if relay_dir_ok; then
        rm -rf "$GPG_RELAY_DIR" 2>/dev/null || true
    fi
    if docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        print_info "Removing Docker image '$IMAGE_NAME'..."
        docker rmi "$IMAGE_NAME"
        print_success "Docker image removed"
    else
        print_info "Docker image '$IMAGE_NAME' does not exist"
    fi
}

# Function to show or edit configuration
show_config() {
    local subcommand="${1:-show}"
    shift || true

    case "$subcommand" in
    show)
        parse_config
        print_config
        maybe_drift_hint
        ;;
    edit)
        local editor
        if ! editor=$(resolve_editor); then
            print_error "No editor found (set \$EDITOR or install sensible-editor, vi or nano)"
            exit 1
        fi
        if [ ! -f "$CONFIG_FILE" ]; then
            print_warning "Config file does not exist. Running install first..."
            # shellcheck source=lib/install-lib.sh
            source "$REPO_ROOT/lib/install-lib.sh"
            run_install_main --yes --only config || exit 1
        else
            "$editor" "$CONFIG_FILE"
        fi
        ;;
    path)
        echo "$CONFIG_FILE"
        ;;
    sync)
        # Local-only command: refresh the versioned security layer (hooks,
        # policies, settings, mirror) from the repo without starting a
        # container. With --check it only reports drift.
        parse_config || true
        sync_security_layer "${1:-}"
        ;;
    claude)
        # User preferences (read-write in the container) can be edited here;
        # the managed policy is regenerated from the wrapper config.
        local cc_sub="${1:-path}"
        local cc_config="$CCODE_HOME/.claude/settings.json"
        case "$cc_sub" in
        path)
            echo "$cc_config"
            ;;
        edit)
            local editor
            if ! editor=$(resolve_editor); then
                print_error "No editor found (set \$EDITOR or install sensible-editor, vi or nano)"
                exit 1
            fi
            "$editor" "$cc_config"
            ;;
        policy)
            echo "$CCODE_HOME/etc/claude-code/managed-settings.json"
            ;;
        *)
            print_error "Usage: $0 config claude [path|edit|policy]"
            exit 1
            ;;
        esac
        ;;
    credentials)
        # Never print values: only the path.
        local cc_sub="${1:-path}"
        case "$cc_sub" in
        path)
            echo "$CCODE_HOME/.claude/.credentials.json"
            ;;
        *)
            print_error "Usage: $0 config credentials path"
            exit 1
            ;;
        esac
        ;;
    *)
        print_error "Unknown config subcommand: $subcommand"
        echo "Usage: $0 config [show|edit|path|sync|claude|credentials]"
        exit 1
        ;;
    esac
}

# Function to show help
show_help() {
    cat <<EOF
Claude Code Docker Wrapper

Usage: $0 [COMMAND] [OPTIONS]

Commands:
    run [DIR]           Run Claude Code in Docker (default: current directory)
    auth                Run Claude Code authentication (claude auth login)
    models              Show the effective default model (/model switches per session)
    exec MSG [OPTS]     Run a non-interactive prompt (claude -p)
    mcp [ARGS]          Manage MCP servers (list|get|login|logout; add/remove are host-only)
    plugin [ARGS]       Manage plugins (list|check; install/update/remove are host-only)
    stats               Show local session-storage statistics
    debug [ARGS]        Debugging helpers (paths|doctor, default: paths)
    doctor              Diagnose install, guard, SSH/GPG, settings, LSP and env file
    install [OPTS]      First-time install / repair PATH, config, completions, aliases
    upgrade [--check|--yes|--no-build|--claude-version X]  Full upgrade: git pull + sync + image rebuild
    build               Build the Docker image
    update [--check|--yes|--no-build|--claude-version X]   Full upgrade: git pull + sync + image rebuild
    version             Show wrapper, guard and Claude Code versions
    config [show|edit|path|sync]      Wrapper config (INI)
    config claude [path|edit|policy]  User Claude settings (writable) / managed policy path
    config credentials path           Credentials file path (values never printed)
    clean               Remove the Docker image
    help                Show this help message

Environment Variables:
    DRY_RUN=true        Print the Docker command without executing it

Examples:
    $0 run                          # Run in current directory
    $0 run /path/to/project         # Run in specific directory
    $0 auth                         # Authenticate (claude auth login)
    $0 models                       # Show effective default model
    $0 exec "Explain this repo"     # Non-interactive prompt
    $0 mcp list                     # Show MCP servers and their status
    $0 mcp login myserver           # OAuth login for an MCP server
    $0 plugin list                  # Show loaded plugins
    $0 stats                        # Local session storage
    $0 debug paths                  # Resolved generated-home paths
    $0 build                        # Build the Docker image
    $0 update                       # Full upgrade: git pull + sync + rebuild
    $0 update --no-build            # Pull + sync only, skip rebuild
    $0 update --claude-version 2.1.300  # Rebuild with a different pinned version
    $0 upgrade --check              # Check for updates from GitHub
    $0 config show                  # Show current configuration
    $0 config edit                  # Edit wrapper config in \$EDITOR
    $0 config sync                  # Refresh security layer (hooks/policies/settings) from repo
    $0 clean                        # Remove Docker image
    DRY_RUN=true $0 run             # Show Docker command without running

Getting Started:
    1. ./install.sh                   # One-liner install (curl|bash): PATH + config
    2. $0 build                     # Build the Docker image (or install --only build)
    3. $0 auth                      # Authenticate (claude auth login)
    4. $0 run /path/to/project      # Run Claude Code

Security Features:
    - Isolated environment: only access to mounted project directory
    - Persistent config: all Claude Code state lives on the host under
      ~/.config/claude-dockerized/home/ and survives restarts and image
      rebuilds. The policy (/etc/claude-code/managed-settings.json) and the
      hooks are mounted READ-ONLY (change them with 'config edit' + 'config
      sync'); ~/.claude/settings.json stays writable for /model and /config
    - Security layer: native PreToolUse hooks + managed permissions.deny,
      generated on the host and delivered read-only; auto-updates are
      disabled (DISABLE_AUTOUPDATER=1) so the pinned version always runs
    - Remote flows allowed: git over SSH, remote MCP (http/sse), registries
      and APIs work in every policy mode; only destruction, exfiltration,
      secrets and Docker escapes are blocked
    - Non-root user: runs as non-root user inside container
    - Automatic cleanup: containers are removed on exit (--rm)

Note: The host Docker socket is NOT mounted by default. It is opt-in because it
grants the container full control of the host Docker daemon (root-equivalent
on the host) and defeats the sandbox. Enable it with setting.docker_socket=true
in the config only when you need Docker-in-Docker / Testcontainers.

Security policy: setting.security_policy (strict | balanced | none) controls the
vendored policy pattern sets enforced by the native hooks. The default
balanced drops patterns meant for shared cloud sandboxes and other common
false positives while keeping the dangerous ones.

Claude Code self-update is disabled inside the container (managed settings);
use '$0 update' to rebuild with a newer pinned version.

For more information, see README.md
EOF
}

# Function to show version
show_version() {
    echo "claude-dockerized $WRAPPER_VERSION (guard $(grep -oE 'CLAUDE_DOCKERIZED_GUARD_VERSION=[0-9]+' "$REPO_ROOT/hooks/claude-guard-bash.sh" 2>/dev/null | head -1 || echo unknown))"
    check_image "$IMAGE_NAME" || exit 1
    docker run --rm --entrypoint bash "$IMAGE_NAME" -c "claude --version"
}

# Main script logic
main() {
    check_not_root

    local command="${1:-run}"
    shift || true

    case "$command" in
    run)
        check_docker
        check_config
        run_claude "$@"
        ;;
    auth)
        check_docker
        run_auth
        ;;
    models)
        show_models "$@"
        ;;
    exec)
        check_docker
        exec_prompt "$@"
        ;;
    mcp)
        check_docker
        manage_mcp "$@"
        ;;
    plugin)
        check_docker
        manage_plugins "$@"
        ;;
    stats)
        show_stats "$@"
        ;;
    debug)
        run_debug "$@"
        ;;
    doctor)
        check_docker
        run_doctor
        ;;
    build)
        check_docker
        build_image
        ;;
    install)
        # shellcheck source=lib/install-lib.sh
        source "$REPO_ROOT/lib/install-lib.sh"
        run_install_main "$@"
        ;;
    upgrade)
        upgrade_wrapper "$@"
        ;;
    uninstall)
        print_info "To uninstall: remove the 'claude-dockerized/bin' PATH line from ~/.bashrc/~/.zshrc,"
        print_info "then delete $REPO_ROOT (config in $CONFIG_DIR is left untouched)."
        ;;
    update)
        update_claude "$@"
        ;;
    version)
        check_docker
        show_version
        ;;
    config)
        # Local-only command: works without a running Docker daemon.
        show_config "$@"
        ;;
    clean)
        check_docker
        clean_image
        ;;
    help | --help | -h)
        show_help
        ;;
    *)
        print_error "Unknown command: $command"
        echo
        show_help
        exit 1
        ;;
    esac
}

# Run main function
main "$@"
