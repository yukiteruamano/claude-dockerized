#!/bin/bash

# Claude Code Docker Wrapper Script
# This script makes it easy to run Claude Code in a secure Docker container

set -e

# Binary lives in bin/ of the self-contained checkout (Doom-style).
# It is reached via PATH, never via a symlink in ~/.local/bin.
BIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_ROOT="$(cd "$BIN_DIR/.." && pwd)"
IMAGE_NAME="claude-dockerized:latest"

# Wrapper release line, shown by the version command next to the Claude Code
# version and the bundled guard version.
WRAPPER_VERSION="0.1.0"



# Source the shared config module (also provides the output helpers:
# print_info/print_success on stdout, print_warning/print_error on stderr).
source "$REPO_ROOT/lib/config-lib.sh"
# shellcheck source=lib/update-lib.sh
source "$REPO_ROOT/lib/update-lib.sh"
# shellcheck source=lib/diag-lib.sh
source "$REPO_ROOT/lib/diag-lib.sh"
# shellcheck source=lib/help-lib.sh
source "$REPO_ROOT/lib/help-lib.sh"

# Bare `mktemp` honors TMPDIR, so merge temps land in a private dir without
# touching every call site (see ensure_private_tmpdir).
ensure_private_tmpdir

# Refuse to run as root. The container is launched with the host UID/GID, so a
# root invocation would start the sandbox as root and defeat the whole setup.
check_not_root() {
    if [ "$(id -u)" -eq 0 ]; then
        print_error "Do not run this wrapper as root."
        print_info "Run it as your normal user so the container starts as your host UID/GID."
        exit 1
    fi
}

# Image build options from the wrapper config (opt-in; defaults build the
# historic image). Sets IMAGE_BUILD_ARGS. Usage: image_build_args
image_build_args() {
    parse_config || true
    IMAGE_BUILD_ARGS=()
    [ "$IMAGE_STRIP_SETUID" = true ] && IMAGE_BUILD_ARGS+=(--build-arg STRIP_SETUID=1)
    [ "$IMAGE_DOCKER_CLI" = false ] && IMAGE_BUILD_ARGS+=(--build-arg DOCKER_CLI=0)
    # A Claude Code version pinned with `update --claude-version` sticks, with
    # the sha256 recorded on its first build (trust on first use).
    local pinned sha_file
    pinned=$(update_saved_claude_version)
    if [ -n "$pinned" ] && [ -z "${_UP_CLAUDE_VERSION:-}" ]; then
        IMAGE_BUILD_ARGS+=(--build-arg "CLAUDE_CODE_VERSION=$pinned")
        sha_file=$(update_claude_sha_file "$pinned")
        if [ -s "$sha_file" ]; then
            IMAGE_BUILD_ARGS+=(--build-arg "CLAUDE_CODE_SHA256=$(head -n1 "$sha_file")")
        fi
    fi
    return 0
}

# Function to build the Docker image
build_image() {
    local -a extra=()
    local arg
    for arg in "$@"; do
        case "$arg" in
        --no-cache | --pull) extra+=("$arg") ;;
        *)
            print_error "Unknown build option: $arg (use --no-cache, --pull)"
            return 1
            ;;
        esac
    done
    print_info "Building Claude Code Docker image..."
    image_build_args
    # Regular build uses Docker layer cache normally.
    # Only the 'update' command passes CLAUDE_BUILD_TIME to bust the cache.
    docker build "${extra[@]}" "${IMAGE_BUILD_ARGS[@]}" -t "$IMAGE_NAME" "$REPO_ROOT"
    print_success "Docker image built successfully"
}

# Offer to build a missing image on first run (interactive only).
# Usage: ensure_image_or_offer_build
ensure_image_or_offer_build() {
    docker image inspect "$IMAGE_NAME" >/dev/null 2>&1 && return 0
    if [ -t 0 ] && [ -t 1 ] && [ "${DRY_RUN:-false}" != true ]; then
        local ans
        print_warning "Image $IMAGE_NAME is not built yet."
        read -r -p "Build it now? (Y/n): " ans || ans=""
        if [[ "${ans:-y}" =~ ^[Yy]$ ]]; then
            build_image && return 0
        fi
    fi
    check_image "$IMAGE_NAME"
}

# Function to check required configuration files (self-contained CCODE_HOME tree)
check_config() {
    local missing_files=()

    if [ ! -f "$CCODE_HOME/etc/claude-code/managed-settings.json" ]; then
        missing_files+=("$CCODE_HOME/etc/claude-code/managed-settings.json")
    fi

    if [ ! -d "$CCODE_HOME/.local/share/claude" ]; then
        missing_files+=("$CCODE_HOME/.local/share/claude/")
    fi

    if [ ! -d "$CCODE_HOME/.local/state/claude" ]; then
        missing_files+=("$CCODE_HOME/.local/state/claude/")
    fi

    if [ ${#missing_files[@]} -gt 0 ]; then
        print_warning "Some Claude Code configuration files are missing:"
        for file in "${missing_files[@]}"; do
            echo "  - $file"
        done
        print_info "Claude Code will run but may need configuration. Run 'claude auth login' inside the container."
    fi

    # Ensure storage directories exist and the security layer is present.
    # The config is parsed first so the managed layer is generated once with
    # the configured policy/model, never with defaults (then rewritten).
    parse_config
    ensure_claude_dirs
}

# Run a one-off Claude Code CLI command inside the container.
# The project directory is mounted so project-level configuration applies.
# Usage: run_cli_command <name_suffix> <project_dir> <docker_socket> <claude_args...>
run_cli_command() {
    local name_suffix="$1"
    local project_dir="$2"
    local docker_socket="$3"
    shift 3

    if [ -n "$project_dir" ]; then
        if [ ! -d "$project_dir" ]; then
            print_error "Project directory does not exist: $project_dir"
            exit 1
        fi
        project_dir="$(cd "$project_dir" && pwd -P)"
        validate_project_dir "$project_dir" || exit 1
    fi

    check_image "$IMAGE_NAME" || exit 1
    parse_config
    ensure_claude_dirs

    build_mount_args
    build_env_args
    build_env_file_args
    build_common_docker_args
    build_standard_volume_args "$project_dir" "$docker_socket"

    # Allocate a TTY only when attached to one, so the command stays pipeable
    local -a tty_args=(-i)
    [ -t 0 ] && [ -t 1 ] && tty_args=(-it)

    local -a workdir_args=()
    [ -n "$CONTAINER_WORKDIR" ] && workdir_args=(--workdir "$CONTAINER_WORKDIR")

    local -a docker_cmd=(
        docker run "${tty_args[@]}"
        --name "claude-${name_suffix}-$$"
        "${workdir_args[@]}"
        "${DOCKER_COMMON_ARGS[@]}"
        "${VOLUME_ARGS[@]}"
        "${GIT_WORKTREE_ARGS[@]}"
        "${DOCKER_MOUNT_ARGS[@]}"
        "${DOCKER_ENV_ARGS[@]}"
        "${DOCKER_ENV_FILE_ARGS[@]}"
        "$IMAGE_NAME"
        "$@"
    )

    if [ "${DRY_RUN:-false}" = true ]; then
        print_info "Dry run — would execute:"
        dry_run_print "${docker_cmd[@]}"
        stop_gpg_relay "$GPG_RELAY_SOCKET"
        GPG_RELAY_SOCKET=""
        return 0
    fi

    # Stop the per-session GnuPG relay when the container exits (also on error
    # or Ctrl-C via the EXIT/INT/TERM trap).
    trap 'stop_gpg_relay "$GPG_RELAY_SOCKET"' EXIT INT TERM
    "${docker_cmd[@]}"
    stop_gpg_relay "$GPG_RELAY_SOCKET"
    GPG_RELAY_SOCKET=""
    trap - EXIT INT TERM
}

# Function to run Claude Code authentication
run_auth() {
    print_info "Running Claude Code authentication..."
    print_info "Complete the login in the container (browser or pasted OAuth code)."

    if ! run_cli_command auth "" false claude auth login; then
        print_error "Authentication failed"
        exit 1
    fi

    print_success "Authentication complete! Your credentials are saved in $CCODE_HOME/.claude/.credentials.json"
}

# Function to run Claude Code
run_claude() {
    local project_dir="" dry_run="${DRY_RUN:-false}"
    local -a claude_args=()
    while [ $# -gt 0 ]; do
        case "$1" in
        --)
            shift
            claude_args=("$@")
            break
            ;;
        -h | --help)
            command_help run
            return 0
            ;;
        -*)
            print_error "Unknown run option: $1 (pass Claude Code options after --, e.g. run . -- --resume)"
            exit 1
            ;;
        *)
            if [ -n "$project_dir" ]; then
                print_error "run takes one directory; pass Claude Code arguments after --"
                exit 1
            fi
            project_dir="$1"
            ;;
        esac
        shift
    done
    project_dir="${project_dir:-$(pwd)}"

    # Validate project directory exists
    if [ ! -d "$project_dir" ]; then
        print_error "Project directory does not exist: $project_dir"
        exit 1
    fi

    # Convert to absolute, symlink-resolved path (a symlink to $HOME or / must
    # not slip past validate_project_dir).
    project_dir="$(cd "$project_dir" && pwd -P)"

    # Never mount "/", $HOME or an ancestor of $HOME: it would expose the host
    # home (or the whole filesystem) read-write to the agent.
    validate_project_dir "$project_dir" || exit 1

    ensure_image_or_offer_build || exit 1

    # Generate unique container name based on project directory and random suffix
    local dir_name
    dir_name=$(sanitize_container_name "$(basename "$project_dir")")
    local random_suffix
    random_suffix=$(generate_random_suffix)
    local container_name="claude-${dir_name}-${random_suffix}"

    print_info "Starting Claude Code in Docker..."
    print_info "Project directory: $project_dir"
    print_info "Container name: $container_name"

    # Parse custom config and build docker arguments
    parse_config
    build_mount_args
    build_env_args
    build_env_file_args
    build_common_docker_args
    # Docker socket is opt-in: mounting it is root-equivalent on the host.
    build_standard_volume_args "$project_dir" "$DOCKER_SOCKET"

    # CONTAINER_WORKDIR is set by build_standard_volume_args (host path with $HOME stripped)
    local -a model_args=()
    [ -n "$CLAUDE_MODEL" ] && model_args=(--model "$CLAUDE_MODEL")

    local -a docker_cmd=(
        docker run -it
        --name "$container_name"
        --workdir "$CONTAINER_WORKDIR"
        -e "CLAUDE_DOCKERIZED_WORKDIR=$CONTAINER_WORKDIR"
        "${DOCKER_COMMON_ARGS[@]}"
        "${VOLUME_ARGS[@]}"
        "${GIT_WORKTREE_ARGS[@]}"
        "${DOCKER_MOUNT_ARGS[@]}"
        "${DOCKER_ENV_ARGS[@]}"
        "${DOCKER_ENV_FILE_ARGS[@]}"
        "$IMAGE_NAME"
        claude "${model_args[@]}" "${claude_args[@]}"
    )

    if [ "$dry_run" = true ]; then
        print_info "Dry run — would execute:"
        dry_run_print "${docker_cmd[@]}"
        stop_gpg_relay "$GPG_RELAY_SOCKET"
        GPG_RELAY_SOCKET=""
        return 0
    fi

    # Fingerprint the persistent paths the session could plant code in
    # (setting.integrity_check, default on); compared after the session.
    local snap_before="" snap_after=""
    if [ "$INTEGRITY_CHECK" = true ]; then
        if snap_before=$(mktemp 2>/dev/null); then
            integrity_snapshot "$project_dir" "$snap_before"
        else
            snap_before=""
        fi
    fi

    # Stop the per-session GnuPG relay when the container exits.
    trap 'stop_gpg_relay "$GPG_RELAY_SOCKET"' EXIT INT TERM
    local rc=0
    "${docker_cmd[@]}" || rc=$?
    stop_gpg_relay "$GPG_RELAY_SOCKET"
    GPG_RELAY_SOCKET=""
    trap - EXIT INT TERM

    if [ -n "$snap_before" ]; then
        if snap_after=$(mktemp 2>/dev/null); then
            integrity_snapshot "$project_dir" "$snap_after"
            integrity_report "$project_dir" "$snap_before" "$snap_after" || true
        fi
        rm -f "$snap_before" "$snap_after"
    fi

    # Propagate Claude Code's own exit status (130 on Ctrl-C, etc.).
    if [ "$rc" -ne 0 ]; then
        print_error "Claude Code exited with status $rc"
        exit "$rc"
    fi
}

# Self-update (`update`, with `upgrade` as an alias): verified, fast-forward
# only, previewed, reversible. See lib/update-lib.sh for the trust model.
#   update [--check] [--yes] [--dry-run] [--no-build] [--channel tags|branch]
#          [--claude-version X.Y.Z] [--allow-unsigned] [--trust-key FILE]
# --check exit codes: 0 up to date, 100 update available, 1 error.

# Print the update usage. Usage: update_usage <command-name>
update_usage() {
    cat <<EOF
Usage: claude-dockerized $1 [OPTIONS]

Verified self-update: fetch, verify the release signature against your
pinned keys, preview the changes, fast-forward, re-sync and rebuild.

Options:
  --check                  only report (exit 0 up to date, 100 update available, 1 error)
  --dry-run                verify and preview the update, change nothing
  --yes                    apply without the confirmation prompt
  --no-build               update code + security layer, skip the image rebuild
  --channel tags|branch    signed release tags (default) or signed upstream commits
  --claude-version X.Y.Z   pin another Claude Code release (kept for later builds)
  --allow-unsigned         accept unverified code (interactive confirmation required)
  --trust-key FILE         pin a release-signing key (OpenPGP key or ssh allowed-signers)

Rollback: claude-dockerized rollback [--yes]
EOF
}

# Parse update flags into _UP_* globals.
# Returns 0 to proceed, 3 when usage was printed (--help), 1 on bad usage.
# Usage: _parse_self_update_flags <command-name> [flags...]
_parse_self_update_flags() {
    local cmd="$1"
    shift
    _UP_CHECK=false _UP_YES=false _UP_NO_BUILD=false _UP_DRY_RUN=false
    _UP_ALLOW_UNSIGNED=false _UP_POST_PULL=false
    _UP_CLAUDE_VERSION="" _UP_TRUST_KEY="" _UP_CHANNEL="tags"
    local arg
    while [ $# -gt 0 ]; do
        arg="$1"
        shift
        case "$arg" in
        --check) _UP_CHECK=true ;;
        --yes) _UP_YES=true ;;
        --no-build) _UP_NO_BUILD=true ;;
        --dry-run) _UP_DRY_RUN=true ;;
        --allow-unsigned) _UP_ALLOW_UNSIGNED=true ;;
        --post-pull) _UP_POST_PULL=true ;;
        --channel | --claude-version | --trust-key)
            [ -n "${1:-}" ] || {
                print_error "Missing value for $arg"
                return 1
            }
            case "$arg" in
            --channel) _UP_CHANNEL="$1" ;;
            --claude-version) _UP_CLAUDE_VERSION="$1" ;;
            --trust-key) _UP_TRUST_KEY="$1" ;;
            esac
            shift
            ;;
        --channel=*) _UP_CHANNEL="${arg#--channel=}" ;;
        --claude-version=*) _UP_CLAUDE_VERSION="${arg#--claude-version=}" ;;
        --trust-key=*) _UP_TRUST_KEY="${arg#--trust-key=}" ;;
        --help | -h)
            update_usage "$cmd"
            return 3
            ;;
        *)
            print_error "Unknown $cmd option: $arg (see: claude-dockerized $cmd --help)"
            return 1
            ;;
        esac
    done
    if [ -n "$_UP_CLAUDE_VERSION" ] && [[ ! "$_UP_CLAUDE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        print_error "Invalid --claude-version '$_UP_CLAUDE_VERSION' (use X.Y.Z)"
        return 1
    fi
    case "$_UP_CHANNEL" in
    tags | branch) ;;
    *)
        print_error "Invalid --channel '$_UP_CHANNEL' (use tags|branch)"
        return 1
        ;;
    esac
    return 0
}

# Rebuild the image with the pinned Claude Code (cache-busted). The current
# image is tagged :prev first so `rollback` can restore it; the binary's
# sha256 is recorded per version/arch and enforced on later builds (TOFU).
_rebuild_claude_image() {
    local version="${_UP_CLAUDE_VERSION:-$(update_saved_claude_version)}"
    local -a version_args=()
    [ -n "$version" ] && print_info "Pinned Claude Code version: $version"
    # A saved pin is passed by image_build_args; only an explicit
    # --claude-version is added here.
    if [ -n "${_UP_CLAUDE_VERSION:-}" ]; then
        version_args+=(--build-arg "CLAUDE_CODE_VERSION=$version")
        local sha_file
        sha_file=$(update_claude_sha_file "$version")
        [ -s "$sha_file" ] && version_args+=(--build-arg "CLAUDE_CODE_SHA256=$(head -n1 "$sha_file")")
    fi
    if docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        docker tag "$IMAGE_NAME" "${IMAGE_NAME%%:*}:prev" >/dev/null 2>&1 &&
            print_info "Previous image kept as ${IMAGE_NAME%%:*}:prev (rollback)"
    fi
    image_build_args
    print_info "Rebuilding image..."
    if ! docker build --build-arg "CLAUDE_BUILD_TIME=$(date +%s)" "${version_args[@]}" "${IMAGE_BUILD_ARGS[@]}" -t "$IMAGE_NAME" "$REPO_ROOT"; then
        print_error "Image rebuild failed; the previous image is unchanged."
        print_info "Undo the code update with: claude-dockerized rollback"
        return 1
    fi
    local installed_sha actual_version
    actual_version=$(docker run --rm --entrypoint bash "$IMAGE_NAME" -c "claude --version" 2>/dev/null | cut -d' ' -f1)
    print_info "Claude Code in the image: ${actual_version:-unknown}"
    if [ -n "$version" ] && [ -n "$actual_version" ] && [ "$actual_version" != "$version" ]; then
        print_error "The image runs Claude Code $actual_version, not the pinned $version."
        return 1
    fi
    installed_sha=$(docker run --rm --entrypoint sha256sum "$IMAGE_NAME" /usr/local/bin/claude 2>/dev/null | cut -d' ' -f1)
    if [ -n "$version" ] && [ -n "$installed_sha" ]; then
        local sha_file
        sha_file=$(update_claude_sha_file "$version")
        [ -s "$sha_file" ] || printf '%s\n' "$installed_sha" >"$sha_file"
    fi
    [ -n "$version" ] && update_save_claude_version "$version"
    return 0
}

# Second half of an update, run by the NEW code after the fast-forward
# (re-exec), so the refreshed security layer comes from the updated lib/.
_update_post_pull() {
    print_info "Refreshing security layer..."
    parse_config || true
    sync_security_layer || true
    if [ "$_UP_NO_BUILD" = true ]; then
        print_success "Update complete (code + security layer; image untouched, --no-build)."
        return 0
    fi
    check_docker || return 1
    _rebuild_claude_image || return 1
    print_success "Update complete (code + security layer + image)."
}

# Full update. Usage: full_upgrade <command-name> [flags...]
full_upgrade() {
    local cmd="$1" rc=0
    shift
    _parse_self_update_flags "$cmd" "$@" || rc=$?
    [ "$rc" -eq 3 ] && return 0
    [ "$rc" -eq 0 ] || return "$rc"

    if [ -n "$_UP_TRUST_KEY" ]; then
        update_trust_key "$_UP_TRUST_KEY"
        return $?
    fi
    [ "$_UP_POST_PULL" = true ] && {
        _update_post_pull
        return $?
    }

    if [ ! -d "$REPO_ROOT/.git" ] || ! command -v git >/dev/null 2>&1; then
        print_error "Self-update needs git and a git checkout ($REPO_ROOT); reinstall with install.sh."
        return 1
    fi
    update_check_origin || return 1
    if [ "$_UP_CHANNEL" = branch ] && ! git -C "$REPO_ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
        print_error "No upstream tracking branch; set one with 'git branch --set-upstream-to=origin/<branch>'."
        return 1
    fi

    # One fetch: what is verified below is exactly what gets merged. A tag
    # that was rewritten upstream makes the fetch fail (never clobbered).
    local fetch_err
    if ! fetch_err=$(git -C "$REPO_ROOT" fetch --tags origin 2>&1); then
        print_error "Could not fetch from origin:"
        printf '%s\n' "$fetch_err" | tail -n 5 >&2
        case "$fetch_err" in
        *clobber*) print_warning "A release tag was rewritten upstream: refusing to update. Report it to the maintainer." ;;
        esac
        return 1
    fi

    local target sel_rc=0
    target=$(update_select_target "$_UP_CHANNEL") || sel_rc=$?
    if [ "$sel_rc" -eq 2 ]; then
        print_error "Local checkout diverged from upstream; resolve manually with git (no forced update)."
        git -C "$REPO_ROOT" status -sb | head -5
        return 1
    fi
    if [ -z "$target" ]; then
        print_success "Already up to date ($(git -C "$REPO_ROOT" describe --tags --always 2>/dev/null))."
        [ "$_UP_CHECK" = true ] && return 0
        [ "$_UP_DRY_RUN" = true ] && return 0
        if [ -n "$_UP_CLAUDE_VERSION" ] && [ "$_UP_NO_BUILD" != true ]; then
            check_docker || return 1
            _rebuild_claude_image
            return $?
        fi
        parse_config || true
        sync_security_layer >/dev/null 2>&1 || true
        return 0
    fi

    local signer="" verified=true
    signer=$(update_verify_ref "$target") || verified=false
    if [ "$_UP_CHECK" = true ]; then
        print_info "Update available: $target ($([ "$verified" = true ] && echo "signed by $signer" || echo "NOT verified by a trusted key"))."
        return 100
    fi
    update_preview "$target"
    if [ "$verified" = true ]; then
        print_success "Signature verified: $signer"
    else
        print_error "$target is not signed by a trusted release key."
        if ! update_has_trust; then
            print_info "No release key is pinned yet. Obtain the maintainer's public key out of band, then:"
            print_info "  claude-dockerized update --trust-key <key-file>"
        fi
        if [ "$_UP_ALLOW_UNSIGNED" != true ]; then
            return 1
        fi
        if [ ! -t 0 ]; then
            print_error "--allow-unsigned needs an interactive confirmation."
            return 1
        fi
        local ans
        print_warning "Unverified code runs on your host (bin/, lib/) and becomes the guard."
        read -r -p "Apply UNVERIFIED code anyway? Type 'unverified' to confirm: " ans || ans=""
        [ "$ans" = unverified ] || {
            print_info "Aborted."
            return 1
        }
    fi
    [ "$_UP_DRY_RUN" = true ] && {
        print_info "Dry run: nothing changed."
        return 0
    }
    if [ "$_UP_YES" != true ]; then
        if [ ! -t 0 ]; then
            print_error "Confirmation required: run from a terminal or pass --yes."
            return 1
        fi
        local ans
        read -r -p "Apply this update? (y/N): " ans || ans=""
        [[ "$ans" =~ ^[Yy]$ ]] || {
            print_info "Aborted."
            return 1
        }
    fi

    update_record_rollback || return 1
    local commit
    commit=$(git -C "$REPO_ROOT" rev-parse "$target^{commit}") || return 1
    if ! git -C "$REPO_ROOT" merge --quiet --ff-only "$commit"; then
        print_error "Fast-forward failed; nothing was changed."
        return 1
    fi
    print_success "Code updated to $target ($commit)."

    # Continue with the NEW code (sync + rebuild).
    local -a post=(--post-pull)
    [ "$_UP_NO_BUILD" = true ] && post+=(--no-build)
    [ -n "$_UP_CLAUDE_VERSION" ] && post+=(--claude-version "$_UP_CLAUDE_VERSION")
    exec "$REPO_ROOT/bin/claude-dockerized" update "${post[@]}"
}

# `upgrade` is an alias of `update` (kept for muscle memory).
upgrade_wrapper() {
    full_upgrade upgrade "$@"
}

update_claude() {
    full_upgrade update "$@"
}

# Undo the last update (code checkout + image tag), then re-sync with the
# restored code. Usage: rollback_update [--yes]
rollback_update() {
    local yes=false
    case "${1:-}" in
    --yes) yes=true ;;
    -h | --help)
        echo "Usage: claude-dockerized rollback [--yes]  (restore the checkout and image from before the last update)"
        return 0
        ;;
    "") ;;
    *)
        print_error "Unknown rollback option: $1"
        return 1
        ;;
    esac
    update_rollback "$yes" || return 1
    exec "$REPO_ROOT/bin/claude-dockerized" config sync
}

# Function to report the effective model configuration (local-only).
# Claude Code has no `models` list endpoint; the default comes from
# setting.model and can be switched per session with /model or --model.
show_models() {
    parse_config || true
    if [ -n "$CLAUDE_MODEL" ]; then
        echo "Default model: $CLAUDE_MODEL (from wrapper config; switch per session with /model)"
    else
        echo "Default model: Claude default (not preset; switch per session with /model)"
    fi
    maybe_drift_hint
}

# Function to show local session storage statistics (local-only, no secrets).
# API usage lives in the provider console; this reports what persists in the
# generated home across up/down/upgrade cycles.
show_stats() {
    parse_config || true
    local share="$CCODE_HOME/.local/share/claude"
    local state="$CCODE_HOME/.local/state/claude"
    local cache="$CCODE_HOME/.cache/claude"
    echo "Session storage (generated home: $CCODE_HOME):"
    for d in "$share" "$state" "$cache"; do
        if [ -d "$d" ]; then
            echo "  $d: $(du -sh "$d" 2>/dev/null | cut -f1)"
        else
            echo "  $d: (missing)"
        fi
    done
    echo "  cleanupPeriodDays: ${CLEANUP_DAYS:-(Claude default)}"
    if [ -f "$CCODE_HOME/.claude/.credentials.json" ]; then
        echo "  login: present (.credentials.json)"
    else
        echo "  login: missing (run 'claude-dockerized auth')"
    fi
}

# Warn that managed config is read-only inside the container and point the
# user at the host-side file to edit. Usage: config_readonly_guard <what>
config_readonly_guard() {
    local what="${1:-changes}"
    print_error "Managed Claude config is read-only inside the container; '$what' is not available from here."
    print_info "Change it on the host instead (claude-dockerized config edit, or claude on the host for MCP/plugins)."
    print_info "Generated home: $CCODE_HOME/.claude/"
}

# The current directory when it can be mounted as a project, else nothing
# (read-only commands such as `mcp list` then run without a project mount,
# e.g. from $HOME). Usage: dir=$(optional_project_dir)
optional_project_dir() {
    local dir
    dir="$(pwd -P)"
    if validate_project_dir "$dir" >/dev/null 2>&1; then
        printf '%s' "$dir"
    fi
}

# Function to manage MCP servers (list, get, login, logout pass through;
# add/remove are host-only because managed config is read-only).
manage_mcp() {
    local subcommand="${1:-list}"
    shift || true
    case "$subcommand" in
    add | remove | reset)
        config_readonly_guard "claude mcp $subcommand"
        exit 1
        ;;
    esac
    run_cli_command mcp "$(optional_project_dir)" false claude mcp "$subcommand" "$@"
}

# Function to manage plugins (read-only subcommands pass through;
# install/update/remove are host-only).
manage_plugins() {
    local subcommand="${1:-list}"
    shift || true
    case "$subcommand" in
    install | add | update | upgrade | remove | uninstall | enable | disable)
        config_readonly_guard "claude plugin $subcommand"
        exit 1
        ;;
    esac
    run_cli_command plugin "$(optional_project_dir)" false claude plugin "$subcommand" "$@"
}

# Function to run debugging helpers.
# `paths` is local-only (resolved wrapper paths); `doctor` runs the native
# `claude doctor` inside the container; anything else passes to `claude --debug`.
run_debug() {
    local subcommand="${1:-paths}"
    shift || true
    case "$subcommand" in
    paths)
        parse_config || true
        echo "Generated home: $CCODE_HOME"
        echo "Managed policy: $CCODE_HOME/etc/claude-code/managed-settings.json (-> /etc/claude-code, ro)"
        echo "User settings: $CCODE_HOME/.claude/settings.json (writable)"
        echo "Guard hooks: $CCODE_HOME/.claude/hooks-guard/"
        echo "Credentials: $CCODE_HOME/.claude/.credentials.json"
        echo "MCP state: $CCODE_HOME/.claude.json"
        echo "Sessions: $CCODE_HOME/.local/share/claude"
        maybe_drift_hint
        ;;
    doctor)
        check_docker
        run_cli_command debug "" false claude doctor "$@"
        ;;
    *)
        check_docker
        run_cli_command debug "$(pwd)" false claude --debug "$subcommand" "$@"
        ;;
    esac
}

# Diagnose the security layer, SSH and GnuPG forwarding inside the container.
# Project-independent: doctor needs no project mount (like auth).
run_doctor() {
    local json=false
    case "${1:-}" in
    --json) json=true ;;
    "") ;;
    -h | --help)
        command_help doctor
        return 0
        ;;
    *)
        print_error "Unknown doctor option: $1 (use --json)"
        return 1
        ;;
    esac
    parse_config >/dev/null 2>&1 || true
    doctor_host_checks
    local host_rc=0
    if [ "$json" = true ]; then
        doctor_print_host true || host_rc=1
        return "$host_rc"
    fi
    echo "== host =="
    doctor_print_host false || host_rc=1
    if ! docker info >/dev/null 2>&1 || ! docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        print_warning "container checks skipped (Docker or the image is unavailable)"
        return 1
    fi
    echo "== container =="
    local container_rc=0
    run_cli_command doctor "" false bash -c "$(cat "$REPO_ROOT/lib/doctor-container.sh")" || container_rc=$?
    [ "$host_rc" -eq 0 ] && [ "$container_rc" -eq 0 ]
}

# Function to run a non-interactive prompt and print the result
exec_prompt() {
    if [ $# -eq 0 ]; then
        print_error "A message is required: claude-dockerized exec \"<message>\" [OPTIONS]"
        exit 1
    fi
    # Docker socket follows the opt-in config, as in 'run'. parse_config must run
    # first so DOCKER_SOCKET reflects setting.docker_socket before it is read.
    parse_config
    local -a model_args=()
    [ -n "$CLAUDE_MODEL" ] && model_args=(--model "$CLAUDE_MODEL")
    run_cli_command exec "$(pwd)" "$DOCKER_SOCKET" claude -p "${model_args[@]}" "$@"
}

# Function to clean up Docker image
clean_image() {
    # Drop any relay processes/dirs left by crashed sessions.
    cleanup_stale_relays
    if relay_dir_ok; then
        rm -rf "$GPG_RELAY_DIR" 2>/dev/null || true
    fi
    if docker image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
        print_info "Removing Docker image '$IMAGE_NAME'..."
        docker rmi "$IMAGE_NAME"
        print_success "Docker image removed"
    else
        print_info "Docker image '$IMAGE_NAME' does not exist"
    fi
}

# Function to show or edit configuration
show_config() {
    local subcommand="${1:-show}"
    shift || true

    case "$subcommand" in
    show)
        parse_config
        print_config
        maybe_drift_hint
        ;;
    edit)
        local editor
        if ! editor=$(resolve_editor); then
            print_error "No editor found (set \$EDITOR or install sensible-editor, vi or nano)"
            exit 1
        fi
        if [ ! -f "$CONFIG_FILE" ]; then
            print_warning "Config file does not exist. Running install first..."
            # shellcheck source=lib/install-lib.sh
            source "$REPO_ROOT/lib/install-lib.sh"
            run_install_main --yes --only config || exit 1
        else
            "$editor" "$CONFIG_FILE"
        fi
        ;;
    path)
        echo "$CONFIG_FILE"
        ;;
    sync)
        # Local-only command: refresh the versioned security layer (hooks,
        # policies, settings, mirror) from the repo without starting a
        # container. With --check it only reports drift.
        parse_config || true
        sync_security_layer "${1:-}"
        ;;
    claude)
        # User preferences (read-write in the container) can be edited here;
        # the managed policy is regenerated from the wrapper config.
        local cc_sub="${1:-path}"
        local cc_config="$CCODE_HOME/.claude/settings.json"
        case "$cc_sub" in
        path)
            echo "$cc_config"
            ;;
        edit)
            local editor
            if ! editor=$(resolve_editor); then
                print_error "No editor found (set \$EDITOR or install sensible-editor, vi or nano)"
                exit 1
            fi
            "$editor" "$cc_config"
            ;;
        policy)
            echo "$CCODE_HOME/etc/claude-code/managed-settings.json"
            ;;
        *)
            print_error "Usage: claude-dockerized config claude [path|edit|policy]"
            exit 1
            ;;
        esac
        ;;
    credentials)
        # Never print values: only the path.
        local cc_sub="${1:-path}"
        case "$cc_sub" in
        path)
            echo "$CCODE_HOME/.claude/.credentials.json"
            ;;
        *)
            print_error "Usage: claude-dockerized config credentials path"
            exit 1
            ;;
        esac
        ;;
    *)
        print_error "Unknown config subcommand: $subcommand"
        command_help config >&2
        exit 1
        ;;
    esac
}

# Main script logic
main() {
    check_not_root

    # Global options (before the command).
    while [ $# -gt 0 ]; do
        case "$1" in
        --no-color)
            export NO_COLOR=1
            ui_init
            shift
            ;;
        -V | --version)
            shift
            set -- version "$@"
            break
            ;;
        *) break ;;
        esac
    done

    local command="${1:-run}"
    shift || true

    # `<command> --help` for every command; update/install/run/doctor parse
    # their own flags (and print the same help).
    case "$command" in
    update | upgrade | install | doctor) ;;
    *)
        case "${1:-}" in
        -h | --help)
            command_help "$command" || {
                print_error "Unknown command: $command"
                exit 1
            }
            return 0
            ;;
        esac
        ;;
    esac

    case "$command" in
    run)
        check_docker
        check_config
        run_claude "$@"
        ;;
    auth)
        check_docker
        run_auth
        ;;
    models)
        show_models "$@"
        ;;
    exec)
        check_docker
        exec_prompt "$@"
        ;;
    mcp)
        check_docker
        manage_mcp "$@"
        ;;
    plugin)
        check_docker
        manage_plugins "$@"
        ;;
    stats)
        show_stats "$@"
        ;;
    debug)
        run_debug "$@"
        ;;
    doctor)
        run_doctor "$@"
        ;;
    build)
        check_docker
        build_image "$@"
        ;;
    install)
        # shellcheck source=lib/install-lib.sh
        source "$REPO_ROOT/lib/install-lib.sh"
        run_install_main "$@"
        ;;
    upgrade)
        upgrade_wrapper "$@"
        ;;
    rollback)
        rollback_update "$@"
        ;;
    uninstall)
        print_info "To uninstall: remove the 'claude-dockerized/bin' PATH line from ~/.bashrc/~/.zshrc,"
        print_info "then delete $REPO_ROOT (config in $CONFIG_DIR is left untouched)."
        ;;
    update)
        update_claude "$@"
        ;;
    version)
        show_version "$@"
        ;;
    config)
        # Local-only command: works without a running Docker daemon.
        show_config "$@"
        ;;
    clean)
        check_docker
        clean_image
        ;;
    help | --help | -h)
        if [ -n "${1:-}" ]; then
            command_help "$1" || {
                print_error "Unknown command: $1"
                exit 1
            }
        else
            show_help
        fi
        ;;
    *)
        print_error "Unknown command: $command (see: claude-dockerized help)"
        exit 1
        ;;
    esac
}

# Run main function
main "$@"
