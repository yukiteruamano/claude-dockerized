{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_DOCKERIZED_POLICY": "balanced"
  },
  "allowManagedHooksOnly": true,
  "sandbox": {
    "enabled": false
  },
  "cleanupPeriodDays": 7,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(rm -rf *)",
      "Bash(docker system prune *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./*.pem)",
      "Read(./**/*.pem)",
      "Read(./*.key)",
      "Read(./**/*.key)",
      "Read(./auth.json)",
      "Read(./**/auth.json)",
      "Read(./credentials*)",
      "Read(./**/credentials*)",
      "Read(./**/.ssh/**)",
      "Read(./**/private-keys-v1.d/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.mcp-auth/**)",
      "Read(~/.composio/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/private-keys-v1.d/**)",
      "Read(//proc/*/environ)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.local/bin/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.git/hooks/**)",
      "Edit(./.git/config)",
      "WebFetch(domain:169.254.169.254)",
      "WebFetch(domain:metadata.google.internal)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(rm -rf /*)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(docker * --privileged *)",
      "Bash(docker * -v /:/ *)",
      "Bash(curl *169.254.169.254*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/coder/.claude/hooks-guard/claude-guard-bash.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/coder/.claude/hooks-guard/claude-guard-file.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
